# For setup: npm run setup:careindex creates a private .env.local
# Store only fictional/synthetic data. No real patient information.
CAREINDEX_SETUP_KEY=
CAREINDEX_DB_PATH=./data/careindex.sqlite
CAREINDEX_BACKUP_DIR=./backups
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recruiter one-click access is disabled by default. Synthetic data ONLY.
CAREINDEX_DATA_MODE=synthetic
CAREINDEX_ENABLE_GUESTS=false

# Optional Travel providers; keep real values private.
FLIGHTAPI_KEY=
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=
TRAVEL_DB_PATH=./data/travel.sqlite
# Public service URL, configured before building a deployed portfolio.
NEXT_PUBLIC_TRUSTMART_URL=http://localhost:8000
